+/* Backport Rockchip fc275078 and the 4e1a12d disable-address fix.
+ * The local AUX helpers return zero on success. Capabilities were read by
+ * analogix_dp_connector_enable() before entering link training.
+ */
+static int analogix_dp_set_assr_mode(struct analogix_dp_device *dp)
+{
+	u8 cap = dp->dpcd[DP_EDP_CONFIGURATION_CAP];
+	u8 before, target, sink;
+	bool enable = !!(cap & DP_ALTERNATE_SCRAMBLER_RESET_CAP);
+	int ret;
+
+	ret = analogix_dp_read_byte_from_dpcd(dp, DP_EDP_CONFIGURATION_SET,
+					  &before);
+	if (ret)
+		return ret;
+
+	target = before & ~DP_ALTERNATE_SCRAMBLER_RESET_ENABLE;
+	if (enable)
+		target |= DP_ALTERNATE_SCRAMBLER_RESET_ENABLE;
+	ret = analogix_dp_write_byte_to_dpcd(dp, DP_EDP_CONFIGURATION_SET,
+					   target);
+	if (ret)
+		return ret;
+
+	ret = analogix_dp_read_byte_from_dpcd(dp, DP_EDP_CONFIGURATION_SET,
+					  &sink);
+	if (ret)
+		return ret;
+	printf("eDP%d ASSR sink: cap=0x%02x before=0x%02x target=0x%02x read=0x%02x\n",
+	       dp->id, cap, before, target, sink);
+	if ((sink ^ target) & DP_ALTERNATE_SCRAMBLER_RESET_ENABLE)
+		return -EIO;
+
+	return analogix_dp_enable_assr_mode(dp, enable);
+}
