+
+int analogix_dp_enable_assr_mode(struct analogix_dp_device *dp, bool enable)
+{
+	u32 before = analogix_dp_read(dp, ANALOGIX_DP_LINK_POLICY);
+	u32 value = before & ~ALTERNATE_SR_ENABLE;
+	u32 after;
+
+	if (enable)
+		value |= ALTERNATE_SR_ENABLE;
+	analogix_dp_write(dp, ANALOGIX_DP_LINK_POLICY, value);
+	after = analogix_dp_read(dp, ANALOGIX_DP_LINK_POLICY);
+	printf("eDP%d ASSR TX: before=0x%08x target=0x%08x read=0x%08x\n",
+	       dp->id, before, value, after);
+
+	return ((after ^ value) & ALTERNATE_SR_ENABLE) ? -EIO : 0;
 }
 
